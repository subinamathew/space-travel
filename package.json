{
  "name": "rocketrun",
  "version": "3.2.0",
  "description": "RocketRun — Interactive Solar System Tour (rocketrun.org)",
  "license": "MIT",
  "homepage": "https://rocketrun.org",
  "main": "src/js/script.js",
  "type": "module",
  "scripts": {
    "build:changelog": "node scripts/generate-changelog.js",
    "build:css": "sass src/scss/main.scss public/css/style.css --style=compressed --no-source-map",
    "build:js": "esbuild src/js/script.js --bundle --minify --target=es2022 --tree-shaking=true --legal-comments=none --charset=utf8 --outfile=public/js/script.min.js",
    "build:planet-js": "esbuild src/js/planet-page.js --bundle --minify --target=es2022 --tree-shaking=true --legal-comments=none --charset=utf8 --outfile=public/js/planet.min.js",
    "build:pages": "node scripts/build-subpages.js",
    "build": "npm run build:changelog && npm run build:pages && npm run build:css && npm run build:js && npm run build:planet-js",
    "test:i18n": "node scripts/test-i18n.js",
    "test:smoke": "node scripts/test-gameplay-smoke.js",
    "test:auth": "node scripts/test-site-auth.js",
    "test:dom": "node scripts/test-gameplay-dom.js",
    "test": "node scripts/test-i18n.js && node scripts/test-site-auth.js && node scripts/test-gameplay-dom.js",
    "watch:css": "sass --watch src/scss:public/css --style=compressed",
    "watch:js": "esbuild src/js/script.js --bundle --minify --outfile=public/js/script.min.js --watch",
    "dev": "npm run build && node -e \"console.log('Build complete. Watching for changes...');\""
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "sass": "^1.85.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "sass": "^1.85.0"
  }
}
